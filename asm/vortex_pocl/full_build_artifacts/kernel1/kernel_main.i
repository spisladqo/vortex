void* vx_local_alloc(uint32_t size) {
  return (void*)((int8_t*)({ size_t __r; __asm__ __volatile__ ("csrr %0, %1" : "=r" (__r) : "i" (0xFC3) : "memory"); __r; }) + __local_group_id * size);
